PYLUX_NPSSO=replace-with-your-npsso-cookie-value
PYLUX_PAIR_CODE=change-this-code
PYLUX_CLOUD_LOCALE=nl-NL
PYLUX_CLOUD_CACHE_DIR=/tmp/pylux-web-catalog
# PYLUX_CLOUD_DATACENTER=Auto
# Set to 1 only after accepting the PlayStation account privacy requirements.
# PYLUX_SKIP_ACCOUNT_ATTR_CHECK=0

# Local development defaults. Use 0.0.0.0 plus TLS for another device.
PYLUX_BRIDGE_BIND=127.0.0.1
PYLUX_BRIDGE_PORT=8080
# PYLUX_TLS_CERT=/absolute/path/fullchain.pem
# PYLUX_TLS_KEY=/absolute/path/privkey.pem
# PYLUX_ICE_SERVERS=stun:stun.example.net:3478
